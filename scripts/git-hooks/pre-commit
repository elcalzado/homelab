#!/usr/bin/env bash
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
export REPO_ROOT

STAGED_NIX_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.nix$' || true)

if [[ -n "$STAGED_NIX_FILES" ]]; then
  echo "Formatting Nix files..."
  echo "$STAGED_NIX_FILES" | xargs nix run nixpkgs#nixfmt -- 2>/dev/null
  echo "$STAGED_NIX_FILES" | xargs git add
fi

"$REPO_ROOT/scripts/update-workflows.sh"
"$REPO_ROOT/scripts/update-backup-jobs.sh"

STAGED_DIR=$(mktemp -d)
trap 'rm -rf "$STAGED_DIR"' EXIT
git checkout-index --prefix="$STAGED_DIR/" --all

cd "$STAGED_DIR"

checks="$REPO_ROOT/scripts/checks.sh"
"$checks" lint
"$checks" shellcheck
"$checks" secrets
"$checks" validate-ssh-keys